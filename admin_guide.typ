#let app-counter = counter("applications")
// Второй параметр status со значением по умолчанию "обязательное"
#let app(title, status: "обязательное") = {
  app-counter.step()
  context {
    let num = app-counter.get().first()
    let ru-letters = ("А", "Б", "В", "Г", "Д", "Е", "Ж", "И", "К", "Л", "М", "Н", "П", "Р", "С", "Т", "У", "Ф", "Х", "Ц", "Ш", "Щ", "Э", "Ю", "Я")
    let app-letter = ru-letters.at(num - 1)
    
    pagebreak(weak: true)
    
    align(center)[
      // Переносим на новую строку и пишем статус в скобках обычным шрифтом (не жирным)
      #heading(level: 1, numbering: none)[
        Приложение #app-letter \
        #text[(#status) \
        #title]
      ]
    ]
  }
}


